# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit a filled-in .env.
# In Azure, set these as App Settings / Key Vault references instead.
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# --- Database --------------------------------------------------------------
# READ-ONLY role used by the API, analytics layer and every agent tool.
# Create it with database/migrations/008_readonly_role.sql.
DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/postgres

# Separate write-capable role used ONLY by the capability classifier.
# Leave unset to run the application with classification disabled.
CLASSIFIER_DATABASE_URL=postgresql+psycopg://product_intelligence_classifier:admin@localhost:5432/postgres

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=15000

# --- LLM -------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint with tool calling.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=<Insert API key here>
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOOL_ITERATIONS=5

# Written to work_item_capability.model_version. Bump when the classifier
# prompt or model changes so stale classifications are re-run.
CLASSIFIER_MODEL_VERSION=pi-classifier-v1
CLASSIFIER_MIN_CONFIDENCE=0.60

# --- Query safety ----------------------------------------------------------
MAX_ROWS_DEFAULT=50
MAX_ROWS_HARD_LIMIT=500

# --- Auth (Entra ID, not yet enforced) -------------------------------------
AUTH_ENABLED=false
AUTH_TENANT_ID=
AUTH_CLIENT_ID=
AUTH_AUDIENCE=

# --- Tests -----------------------------------------------------------------
# TEST_DATABASE_URL=postgresql+psycopg://pi:pi@localhost:5432/pi_test
